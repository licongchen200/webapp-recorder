# Optional AI fallback for click/fill element resolution — only used when
# the deterministic locator heuristics can't find a match. Costs a small
# amount of real API spend per fallback call. Disabled by default.
#
# Copy this file to .env and fill in your key to enable it:
#   cp .env.example .env

ENABLE_AI=false

# Which provider to use: "anthropic" (default) or "openrouter"
AI_PROVIDER=anthropic

# --- anthropic provider ---
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5   # optional override, this is the default

# --- openrouter provider (any OpenRouter-hosted model) ---
OPENROUTER_API_KEY=
# OPENROUTER_MODEL=qwen/qwen3.7-flash   # optional override, this is the default
