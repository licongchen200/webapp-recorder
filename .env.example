# Optional AI fallback for click/fill element resolution — only used when
# the deterministic locator heuristics can't find a match. Costs a small
# amount of real API spend per fallback call (Claude Opus 5). Disabled by
# default; both lines below are required to turn it on.
#
# Copy this file to .env and fill in your key to enable it:
#   cp .env.example .env

ENABLE_AI=false
ANTHROPIC_API_KEY=
